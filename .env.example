# mini-gpt environment variables for the FastAPI service

# path to the trained checkpoint to serve
MINI_GPT_CKPT=out/tiny-shakespeare/ckpt.pt

# tokenizer kind: "char" or "tiktoken-gpt2"
MINI_GPT_TOKENIZER=char

# only used for char tokenizer
MINI_GPT_TOKENIZER_PATH=data/tiny-shakespeare/tokenizer.pkl

# mlflow
MLFLOW_TRACKING_URI=./mlruns
